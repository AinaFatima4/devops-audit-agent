# Required: API key for any OpenAI-compatible provider
LLM_API_KEY=

# Provider and model (defaults shown: Groq, gpt-oss-120b)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional: low | medium | high (only for models that support it); leave empty otherwise
LLM_REASONING_EFFORT=low
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=5

# Optional: agent budget
AGENT_MAX_STEPS=25
AGENT_CONTEXT_CHAR_BUDGET=12000
